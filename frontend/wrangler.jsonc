{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solferme",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    // Application monopage : toute adresse inconnue (ex. /admin → console
    // d'administration) renvoie index.html au lieu d'une erreur 404.
    "not_found_handling": "single-page-application"
  }
}
