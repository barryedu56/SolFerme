# Frontend Environment Variables
EXPO_PUBLIC_API_URL=https://api.solferme.com/api
EXPO_ANDROID_PACKAGE=com.solferme.app
# Sentry (monitoring d'erreurs). DSN du projet React Native — public par nature.
# Vide = Sentry désactivé. Injecté au build via eas.json (pas ici pour le dev).
EXPO_PUBLIC_SENTRY_DSN=
# Notifications push distantes : ID de projet EAS (obtenu via `eas init`).
# Laisser vide = notifications LOCALES uniquement (rappels sur l'appareil).
EXPO_PUBLIC_EAS_PROJECT_ID=
MYAPP_UPLOAD_STORE_FILE=my-release-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=my-key-alias
MYAPP_UPLOAD_STORE_PASSWORD=*****
MYAPP_UPLOAD_KEY_PASSWORD=*****
