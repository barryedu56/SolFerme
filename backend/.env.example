# Django Settings
DJANGO_SECRET_KEY=votre_cle_secrete_longue_ici
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.solferme.com,127.0.0.1

# Database Settings
DB_NAME=solferme
DB_USER=root
DB_PASSWORD=secret_db_password
DB_HOST=localhost
DB_PORT=3306

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://solferme.com,https://www.solferme.com,http://localhost:8081

# Security Settings
DJANGO_SECURE_SSL_REDIRECT=True

# Email (réinitialisation de mot de passe)
# Sans EMAIL_HOST, les emails sont écrits dans la console (dev uniquement).
EMAIL_HOST=smtp.votre-fournisseur.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@solferme.com
EMAIL_HOST_PASSWORD=mot_de_passe_smtp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SolFerme <no-reply@solferme.com>
# Boîte qui reçoit les messages du formulaire de contact du site vitrine
CONTACT_INBOX=support@solferme.com
